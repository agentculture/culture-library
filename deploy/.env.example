# Copy to deploy/.env (gitignored). Every value here is a placeholder or empty: real
# secrets never go in this file. Tunnel tokens are injected with `grant run --inject`.

# --- Image / ports -------------------------------------------------------------
# Image tag (override for throwaway stacks so they never retag the production image).
LIBRARY_IMAGE=culture-library:local
# Host address the published ports bind to. 127.0.0.1 = this machine only; set spark's
# LAN address (e.g. 192.168.1.50) to let LAN machine clients reach them. Never 0.0.0.0
# unless a firewall guards it. The MCP port must stay LAN-only.
LIBRARY_PUBLISH_BIND=127.0.0.1
LIBRARY_PUBLISH_PORT=8796
LIBRARY_PUBLISH_MCP_PORT=8797

# --- Data ----------------------------------------------------------------------
# Empty = named volume `culture-library-data`. Set an absolute host dir for a bind
# mount (must be writable by uid 10001).
LIBRARY_DATA=

# --- Cloudflare Access (public identifiers, not secrets; set both or neither) ----
# <team>.cloudflareaccess.com  (Zero Trust, Settings, team domain)
CULTURE_LIBRARY_ACCESS_TEAM_DOMAIN=
# Audience tag of the library.culture.dev Access application
CULTURE_LIBRARY_ACCESS_AUD=

# --- Server behaviour ------------------------------------------------------------
# Seconds between trash-purge sweeps (empty = server default).
CULTURE_LIBRARY_PURGE_INTERVAL_S=
# JSON list of send targets, e.g. [{"label": "reader", "enabled": true}]; empty = use
# <data dir>/targets.json. Publishing needs events-cli, which the image does not include.
CULTURE_LIBRARY_SEND_TARGETS=
# Base URL a send recipient uses to reach this library (empty = http://127.0.0.1:8796,
# which only works for a client on spark itself; set the LAN URL for other devices).
CULTURE_LIBRARY_LOCAL_URL=

# --- Embeddings (optional; without them search is keyword-only) -------------------
# Gateway key: leave empty here, supply it with `grant run --inject` if used.
GATEWAY_API_KEY=
LOBES_GATEWAY_URL=
LOBES_EMBED_MODEL=

# --- Remote profile ---------------------------------------------------------------
# Connector token of the library.culture.dev tunnel. Leave empty; inject at exec time:
#   grant run --inject TUNNEL_TOKEN=LIBRARY_TUNNEL_TOKEN -- docker compose ... up -d
TUNNEL_TOKEN=
